PORT=<some_number_here>
SEGFORMER_MODEL_PATH=onnx/path_to_segformer_model.onnx
EFFICIENTDET_MODEL_PATH=onnx/path_to_effdet_model.onnx
MEANS=0.485,0.456,0.406
STDS=0.229,0.224,0.225
MODEL_IMAGE_SIZE=1024
EFFDET_ARCHITECTURE=tf_efficientdet_d2

# Path to the class mapping JSON. Defines segformer class names (by class_idx,
# with an overlay rgb color for each) and effdet class names (marker,
# quadrat_corner) under top-level "segformer" / "effdet" keys.
CLASS_MAPPING_PATH=class_mapping.json

# Segformer class index whose pixels represent markers / quadrat frame.
# Used to recover missing ROI corners from the segmentation map when fewer
# than 4 detections are found above the confidence threshold.
# Set to -1 to disable recovery for that type (returns a warning instead).
SEGFORMER_MARKER_CLASS_IDX=-1
SEGFORMER_QUADRAT_CLASS_IDX=-1
